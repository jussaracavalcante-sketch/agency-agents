# Públicas (navegador)
NEXT_PUBLIC_SUPABASE_URL=https://fvxdqportsyyezkzpvqd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor (Vercel > Environment Variables, nunca com prefixo NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=
CREWAI_API_URL=
CREWAI_TOKEN=
# Parte final da URL dos webhooks do receptor (a chave k=...); os três tipos são montados no servidor
WEBHOOK_BASE=https://fvxdqportsyyezkzpvqd.supabase.co/functions/v1/crewai-webhook
WEBHOOK_KEY=
WEBHOOK_AUTOMACAO=agency-agents

# Login (opcionais, públicas)
# Mostra o botão "Continuar com Google" (ative antes o provedor Google em Supabase > Authentication > Providers)
NEXT_PUBLIC_LOGIN_GOOGLE=false
# E-mail exibido em "Fale com o suporte" (deixe vazio para ocultar o link)
NEXT_PUBLIC_SUPORTE_EMAIL=

# Base de conhecimento (opcional): onde ficam os guias originais, um por cliente (knowledge/<slug>/guia_identidade_visual.md)
KNOWLEDGE_RAW_BASE=https://raw.githubusercontent.com/jussaracavalcante-sketch/agency-agents/main/integrations/crewai/marketing-operations/knowledge
