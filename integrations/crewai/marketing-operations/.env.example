# ── Provedor LLM (escolha um) ─────────────────────────────────────────
# Anthropic (recomendado): modelo definido em crew.py via MODEL
ANTHROPIC_API_KEY=
MODEL=anthropic/claude-sonnet-5-5
# Modelo mais barato para tarefas simples (revisão, consolidação)
MODEL_LIGHT=anthropic/claude-haiku-4-5-20251001

# OpenAI (alternativa)
# OPENAI_API_KEY=
# MODEL=openai/gpt-4o

# ── Ferramentas ───────────────────────────────────────────────────────
SERPER_API_KEY=            # pesquisa web (SerperDevTool)
SEMRUSH_API_KEY=           # opcional — ferramenta customizada de SEO
GOOGLE_ADS_DEVELOPER_TOKEN=  # opcional — leitura de métricas/benchmarks
META_ACCESS_TOKEN=         # opcional
RD_STATION_TOKEN=          # opcional — CRM/automação (somente leitura até G3)

# ── Governança ────────────────────────────────────────────────────────
CREW_MAX_RPM=20            # limite de requisições/min para controle de custo
CREW_ENABLE_WRITE_TOOLS=false  # true só em produção, após G3 configurado
CREW_OUTPUT_DIR=output     # pasta dos artefatos das tarefas (criada automaticamente)
CREW_LOG_FILE=             # ex.: output/crew_log.json; vazio = sem log em arquivo (a plataforma já guarda o trace)
