# ── Provedor LLM (basta UMA chave; MODEL é opcional) ──────────────────
# Sem MODEL, o crew.py escolhe pelo provedor da chave presente:
#   ANTHROPIC_API_KEY → anthropic/claude-sonnet-5-5 (leve: claude-haiku-4-5)
#   OPENAI_API_KEY    → openai/gpt-4o              (leve: gpt-4o-mini)
#   GEMINI_API_KEY    → gemini/gemini-2.5-pro      (leve: gemini-2.5-flash)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MODEL=openai/gpt-4o
# MODEL_LIGHT=openai/gpt-4o-mini
# Observação: memory=True usa embeddings da OpenAI por padrão; com outro provedor,
# configure `embedder` na Crew ou mantenha OPENAI_API_KEY para os embeddings.

# ── Ferramentas ───────────────────────────────────────────────────────
SERPER_API_KEY=            # pesquisa web (opcional; sem ela a crew não pesquisa na web)
SEMRUSH_API_KEY=           # opcional — ferramenta customizada de SEO
GOOGLE_ADS_DEVELOPER_TOKEN=  # opcional — leitura de métricas/benchmarks
META_ACCESS_TOKEN=         # opcional
RD_STATION_TOKEN=          # opcional — CRM/automação (somente leitura até G3)

# ── Governança ────────────────────────────────────────────────────────
CREW_MAX_RPM=20            # limite de requisições/min para controle de custo
CREW_ENABLE_WRITE_TOOLS=false  # true só em produção, após G3 configurado
CREW_MEMORY=false          # true liga a memória entre execuções (arriscado: fatos inventados persistem)
CREW_HUMAN_GATES=false     # true = G1/G2/G3 pausam aguardando humano (terminal ou HITL da plataforma)
CREW_OUTPUT_DIR=output     # pasta dos artefatos das tarefas (criada automaticamente)
CREW_LOG_FILE=             # ex.: output/crew_log.json; vazio = sem log em arquivo (a plataforma já guarda o trace)
